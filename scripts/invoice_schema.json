{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice",
  "type": "object",
  "additionalProperties": false,
  "required": ["vendor","customer","invoice_number","invoice_date","due_date","purchase_order","payment_terms","payment_method","currency","line_items","subtotal","discount","tax_amount","total_amount","amount_paid","balance_due","notes"],
  "$defs": {
    "str_or_null": {"type": ["string","null"]},
    "num_or_null": {"type": ["number","null"]},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "date_or_null": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}
  },
  "properties": {
    "vendor": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "address": {"$ref": "#/$defs/str_or_null"}, "phone": {"$ref": "#/$defs/str_or_null"},
        "fax": {"$ref": "#/$defs/str_or_null"}, "email": {"$ref": "#/$defs/str_or_null"},
        "tax_id": {"$ref": "#/$defs/str_or_null"}, "website": {"$ref": "#/$defs/str_or_null"}
      }
    },
    "customer": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/str_or_null"}, "address": {"$ref": "#/$defs/str_or_null"},
        "customer_id": {"$ref": "#/$defs/str_or_null"}, "phone": {"$ref": "#/$defs/str_or_null"},
        "fax": {"$ref": "#/$defs/str_or_null"}, "tax_id": {"$ref": "#/$defs/str_or_null"}
      }
    },
    "invoice_number": {"type": "string", "minLength": 1},
    "invoice_date": {"$ref": "#/$defs/date"},
    "due_date": {"$ref": "#/$defs/date_or_null"},
    "purchase_order": {"$ref": "#/$defs/str_or_null"},
    "payment_terms": {"$ref": "#/$defs/str_or_null"},
    "payment_method": {"$ref": "#/$defs/str_or_null"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "line_items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["description","amount"],
        "properties": {
          "description": {"$ref": "#/$defs/str_or_null"}, "amount": {"$ref": "#/$defs/num_or_null"},
          "quantity": {"$ref": "#/$defs/num_or_null"}, "unit": {"$ref": "#/$defs/str_or_null"},
          "unit_price": {"$ref": "#/$defs/num_or_null"}, "tax_rate": {"$ref": "#/$defs/num_or_null"},
          "tax_amount": {"$ref": "#/$defs/num_or_null"}, "date": {"$ref": "#/$defs/str_or_null"},
          "product_code": {"$ref": "#/$defs/str_or_null"}
        }
      }
    },
    "subtotal": {"$ref": "#/$defs/num_or_null"},
    "discount": {"$ref": "#/$defs/num_or_null"},
    "tax_amount": {"$ref": "#/$defs/num_or_null"},
    "total_amount": {"type": "number"},
    "amount_paid": {"$ref": "#/$defs/num_or_null"},
    "balance_due": {"$ref": "#/$defs/num_or_null"},
    "notes": {"$ref": "#/$defs/str_or_null"}
  }
}
